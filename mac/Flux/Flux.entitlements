<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- WebKit requires this to launch its helper processes even for bundled local pages. -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <!-- Keeps the chosen save folder across launches (output.folder bookmark). -->
  <key>com.apple.security.files.bookmarks.app-scope</key><true/>
  <!-- Feedback reports go to this container's public database (SharedKit feedback, BS-003/BS-004). -->
  <key>com.apple.developer.icloud-container-identifiers</key><array><string>iCloud.com.sequoyah.flux</string></array>
  <key>com.apple.developer.icloud-services</key><array><string>CloudKit</string></array>
</dict></plist>

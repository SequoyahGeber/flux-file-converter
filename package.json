{
  "name": "flux-file-converter",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first file converter for macOS",
  "author": "Flux",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "vite build",
    "native": "swiftc -O native/PDFTool.swift -o resources/pdf-tool -framework PDFKit -framework AppKit",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run native && npm run build && npm run formats && node scripts/package.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:desktop": "npm run build && node tests/desktop.cjs",
    "formats": "node scripts/export-formats.cjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "fast-xml-parser": "^5.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.5.1",
    "playwright": "^1.63.0",
    "vite": "^7.3.0"
  }
}
